# Applies to mcp and ui: they build from the repo root so that lib/ is in the context.
# (db builds from its own folder.)
# Never send the Mac's dependencies or build output into the Linux image.
**/node_modules
**/dist
**/*.tsbuildinfo
.git
.github
.claude
**/.env
**/.env.local
**/*.log
**/.DS_Store
# never part of a server image
plugin
db
demo
