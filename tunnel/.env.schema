# block / tunnel: cloudflared. Committed; pointers only.
#   prod: runs the existing tunnel `block-prod` from its own credentials file (Vault). That credential can
#         only run this one tunnel: no account certificate, no DNS rights. DNS for ghostmind.dev already points here.
#   dev:  the ghostmind.app account certificate creates `block-dev` if missing and routes block.ghostmind.app.
# @plugin(@varlock/hashicorp-vault-plugin@2.1.1)
# @initHcpVault(url=$VAULT_ADDR, token=$VAULT_TOKEN, jwtRole=$VAULT_JWT_ROLE, jwtAuthPath=k8s, oidcToken=$VAULT_JWT, defaultPath=ghostmind/project/block/tunnel)
# @currentEnv=$APP_ENV
# @defaultRequired=true
# @defaultSensitive=false
# ---
# @type=enum(dev, prod)
APP_ENV=dev
# @type=url
VAULT_ADDR=http://vault.tail0e3587.ts.net:8200
# dev: a short-lived dev-session token (Secret vault-dev, k8s/dev-setup.sh). prod: empty, the login below.
# @type=vaultToken @sensitive @required=false
VAULT_TOKEN=
# prod in the cluster: the Deployment sets VAULT_JWT_ROLE; the pod's service-account token (audience vault,
# short-lived, mounted by Kubernetes) is traded for a Vault token at auth/k8s. Nothing secret is handed over.
# @required=false
VAULT_JWT_ROLE=
# @sensitive @internal @required=false
VAULT_JWT=if($VAULT_JWT_ROLE, exec("cat /var/run/secrets/vault/token"))

# the tunnel's own credentials JSON (prod)
# @sensitive @required=false
TUNNEL_CREDENTIALS=if(forEnv(prod), vaultSecret("ghostmind/project/block/tunnel/prod#TUNNEL_CREDENTIALS"))
# the ghostmind.app account certificate, base64 cert.pem (dev)
# @sensitive @required=false
CLOUDFLARED_CREDS=if(forEnv(prod), "", vaultSecret("ghostmind/global/cloudflare#CLOUDFLARED_GHOSTMIND_APP"))
