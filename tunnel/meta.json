{
  "id": "tUn9bLk4Qw2Z",
  "name": "tunnel",
  "version": "0.1.0",
  "type": "app",
  "description": "cloudflared: block.ghostmind.app (dev) and block.ghostmind.dev (prod), by path to block-mcp:3105 and block-ui:5106.",
  "tags": [
    "block",
    "tunnel"
  ],
  "routines": {
    "dev": "skaffold dev --no-prune",
    "dev_keep": "skaffold dev --no-prune --cleanup=false",
    "start": "skaffold run --no-prune",
    "delete": "skaffold delete",
    "prod_logs": "kubectl --context ghostmind -n block logs deploy/tunnel --all-pods --prefix --tail=40 -f"
  },
  "herdr": {
    "workspaces": [
      {
        "label": "block",
        "tabs": [
          {
            "label": "tunnel",
            "prefix": false,
            "layout": "compact",
            "compact": {
              "type": "vertical",
              "panes": [
                {
                  "name": "tunnel",
                  "routine": "dev_keep",
                  "profiles": [
                    "web"
                  ],
                  "description": "The dev tunnel, https://block.ghostmind.app, and its logs (run routine dev_keep: it stays up after Ctrl-C), long-running"
                },
                {
                  "name": "execution-shell",
                  "description": "Free shell for ad-hoc commands"
                }
              ]
            }
          }
        ]
      }
    ]
  }
}
