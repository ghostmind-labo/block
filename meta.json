{
  "id": "bZPNXdqCjD41",
  "name": "block",
  "version": "0.1.0",
  "type": "project",
  "description": "@ghostmind-dev/block, the sandboxed html block shared by the Ghostmind apps, as an open-source npm package, and a demo page to try it locally.",
  "tags": [
    "library",
    "html",
    "sandbox"
  ],
  "routines": {
    "herdr_init": "run herdr init block --all",
    "herdr_attach": "run herdr attach block",
    "herdr_terminate": "run herdr terminate block",
    "claude": "claude"
  },
  "herdr": {
    "workspaces": [
      {
        "label": "block",
        "tabs": [
          {
            "label": "block",
            "prefix": false,
            "layout": "compact",
            "compact": {
              "type": "single",
              "panes": [
                {
                  "name": "claude",
                  "routine": "claude",
                  "description": "Claude Code session for the whole project"
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "links": [
    {
      "label": "Demo (local)",
      "url": "http://localhost:5105"
    },
    {
      "label": "npm",
      "url": "https://www.npmjs.com/package/@ghostmind-dev/block"
    },
    {
      "label": "GitHub",
      "url": "https://github.com/ghostmind-labo/block"
    }
  ]
}
