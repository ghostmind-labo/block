# block / ui: the web app (static React + TanStack). No secrets: it signs in through the mcp server's
# Google OAuth and reads the API with the person's token.
# @currentEnv=$APP_ENV
# @defaultRequired=true
# @defaultSensitive=false
# ---
# @type=enum(dev, prod)
APP_ENV=dev
# @type=port
PORT=5106
# The block server (MCP + API), by its Service name. The web app and the server are one host: the
# tunnel sends /mcp, /oauth, /.well-known and /api there, and so does this app's own server (vite.config.ts)
# for someone who reaches it directly on localhost:5106.
# @type=url
MCP_URL=http://block-mcp:3105
# --- @ghostmind-dev/colors (on trial). on: the page's colours come from the package (every theme offered, a picker
# in the header, light or dark following the system until one is picked), block's 10 variables mapped onto its roles
# (app/src/colors-map.css). off: styles.css alone, exactly as before. In dev, the pill at the top of every page
# flips one browser (localStorage "colors").
# @type=enum(on, off)
COLORS_PACKAGE=if(forEnv(prod), "off", "on")
# Where the package comes from. npm: node_modules, as prod gets it. local (dev only): app/src/colors-local, a copy of
# the colors repo's build kept current by `run routine colors_local` and synced into the pod by skaffold; without
# that copy, npm is used.
# @type=enum(npm, local)
COLORS_SOURCE=if(forEnv(prod), "npm", "local")
