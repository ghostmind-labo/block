# block / ui: the web app (static React + TanStack). No secrets: it signs in through the mcp server's
# Google OAuth and reads the API with the person's token.
# @currentEnv=$APP_ENV
# @defaultRequired=true
# @defaultSensitive=false
# ---
# @type=enum(dev, prod)
APP_ENV=dev
# @type=port
PORT=5106
# The block server (MCP + API), by its Service name. The web app and the server are one host: the dev
# server sends /mcp, /oauth, /.well-known and /api there (vite.config.ts); in prod the tunnel does.
# @type=url
MCP_URL=http://block-mcp:3105
