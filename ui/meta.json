{
  "id": "vkJx2d6ivNf9",
  "name": "ui",
  "version": "0.1.0",
  "type": "app",
  "description": "The web app: every block a person made, each shown in the slot it was written for, and a page to try one without saving it",
  "tags": [
    "block",
    "ui",
    "react"
  ],
  "routines": {
    "dev": "skaffold dev --no-prune",
    "dev_keep": "skaffold dev --no-prune --cleanup=false",
    "start": "skaffold run --no-prune",
    "delete": "skaffold delete"
  },
  "herdr": {
    "workspaces": [
      {
        "label": "block",
        "tabs": [
          {
            "label": "ui",
            "prefix": false,
            "layout": "compact",
            "compact": {
              "type": "vertical",
              "panes": [
                {
                  "name": "dev",
                  "routine": "dev_keep",
                  "profiles": [
                    "web"
                  ],
                  "description": "The web app on http://localhost:5106 with hot reload (run routine dev), long-running"
                },
                {
                  "name": "execution-shell",
                  "description": "Free shell for ad-hoc commands"
                }
              ]
            }
          }
        ]
      }
    ]
  }
}
