# block / db: Hasura on the shared Postgres (the db project). Committed; values are pointers into Vault.
# @plugin(@varlock/hashicorp-vault-plugin@2.1.1)
# @initHcpVault(url=$VAULT_ADDR, token=$VAULT_TOKEN, jwtRole=$VAULT_JWT_ROLE, jwtAuthPath=k8s, oidcToken=$VAULT_JWT, defaultPath=ghostmind/project/block/db)
# @currentEnv=$APP_ENV
# @defaultRequired=true
# @defaultSensitive=false
# ---
# @type=enum(dev, prod)
APP_ENV=dev
# @type=url
VAULT_ADDR=
# dev: the 12h dev-session token (Secret vault-dev, k8s/dev-setup.sh). prod: empty, the login below.
# @type=vaultToken @sensitive @required=false
VAULT_TOKEN=
# prod in the cluster: the Deployment sets VAULT_JWT_ROLE; the pod's service-account token (audience vault,
# short-lived, mounted by Kubernetes) is traded for a Vault token at auth/k8s. Nothing secret is handed over.
# @required=false
VAULT_JWT_ROLE=
# @sensitive @internal @required=false
VAULT_JWT=if($VAULT_JWT_ROLE, exec("cat /var/run/secrets/vault/token"))

# @type=port
PORT=5107
# Hasura CLI (migrate.sh, console.sh) talks to this
# @type=url
HASURA_GRAPHQL_ENDPOINT=http://localhost:5107

# --- this project's role and database on the shared server (created by scripts/create-db.sh), one per env
# @sensitive
DB_USER=if(forEnv(prod), vaultSecret("ghostmind/project/block/db/prod"), vaultSecret("ghostmind/project/block/db/dev"))
# @sensitive
DB_PASSWORD=if(forEnv(prod), vaultSecret("ghostmind/project/block/db/prod"), vaultSecret("ghostmind/project/block/db/dev"))
DB_NAME=if(forEnv(prod), vaultSecret("ghostmind/project/block/db/prod"), vaultSecret("ghostmind/project/block/db/dev"))
# Where the database is: the Postgres of the db project (/Volumes/Projects/db), by its name inside the
# cluster, kept once in Vault for every product. Dev is the M1's cluster, where that server runs.
DB_HOST=vaultSecret("ghostmind/global/postgres")
# @sensitive
HASURA_GRAPHQL_DATABASE_URL=concat("postgres://", $DB_USER, ":", $DB_PASSWORD, "@", $DB_HOST, ":5432/", $DB_NAME, "?sslmode=require")

# --- shared with mcp and ui
# @sensitive
HASURA_GRAPHQL_ADMIN_SECRET=vaultSecret("ghostmind/project/block/auth")
# @sensitive
HASURA_GRAPHQL_JWT_SECRET=vaultSecret("ghostmind/project/block/auth")
