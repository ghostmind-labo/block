# block / lib: the npm package. Committed; no value is written here. The package itself reads no variable:
# only `run routine publish` does, for the npm token, read from Vault when PUBLISH is set.
# @plugin(@varlock/hashicorp-vault-plugin@2.1.1)
# @initHcpVault(url=$VAULT_ADDR, token=$VAULT_TOKEN)
# @currentEnv=$APP_ENV
# @defaultRequired=true
# @defaultSensitive=false
# ---
# @type=enum(dev, prod)
APP_ENV=dev
# @type=url @required=false
VAULT_ADDR=
# host scripts: your shell's token
# @type=vaultToken @sensitive @required=false
VAULT_TOKEN=
# set by scripts/publish.sh: only then is the token read (if() is lazy, so the tests never touch Vault)
# @required=false
PUBLISH=
# a granular npm token with "bypass 2FA", read-and-write on @ghostmind-dev
# @sensitive @required=false
NPM_TOKEN=if($PUBLISH, vaultSecret("ghostmind/global/npm#NPM_TOKEN"))
