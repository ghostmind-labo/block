# block / mcp: remote MCP (Google OAuth) + the API the web app uses. Committed; pointers only.
# @plugin(@varlock/hashicorp-vault-plugin@2.1.1)
# @initHcpVault(url=$VAULT_ADDR, token=$VAULT_TOKEN, jwtRole=$VAULT_JWT_ROLE, jwtAuthPath=k8s, oidcToken=$VAULT_JWT, defaultPath=ghostmind/project/block/mcp)
# @currentEnv=$APP_ENV
# @defaultRequired=true
# @defaultSensitive=false
# ---
# @type=enum(dev, prod)
APP_ENV=dev
# @type=url
VAULT_ADDR=
# dev: the 12h dev-session token (Secret vault-dev, k8s/dev-setup.sh). prod: empty, the login below.
# @type=vaultToken @sensitive @required=false
VAULT_TOKEN=
# prod in the cluster: the Deployment sets VAULT_JWT_ROLE; the pod's service-account token (audience vault,
# short-lived, mounted by Kubernetes) is traded for a Vault token at auth/k8s. Nothing secret is handed over.
# @required=false
VAULT_JWT_ROLE=
# @sensitive @internal @required=false
VAULT_JWT=if($VAULT_JWT_ROLE, exec("cat /var/run/secrets/vault/token"))

# @type=port
PORT=3105
# The public host: OAuth redirects and metadata are built from it. The web app and this server are one host
# (the tunnel sends /mcp, /oauth, /.well-known and /api here; so does the web app's server for someone on localhost:5106).
# @type=url
PUBLIC_URL=if(forEnv(prod), "https://block.ghostmind.dev", "https://block.ghostmind.app")
# Where sign-in may send people back to (comma-separated prefixes). Loopback addresses (Claude Code, the web
# app in dev) are always allowed.
OAUTH_REDIRECT_ALLOW=if(forEnv(prod), "https://block.ghostmind.dev/,https://claude.ai/,https://claude.com/,https://chatgpt.com/", "https://block.ghostmind.app/,https://claude.ai/,https://claude.com/,https://chatgpt.com/")

# Hasura, by its Service name (the same in dev and prod)
# @type=url
HASURA_GRAPHQL_ENDPOINT=http://block-db:5107
# @sensitive
HASURA_GRAPHQL_ADMIN_SECRET=vaultSecret("ghostmind/project/block/auth")
# @sensitive
HASURA_GRAPHQL_JWT_SECRET=vaultSecret("ghostmind/project/block/auth")

# The shared users service: one identity per person across products (auth/shared-users.ts).
# dev: local users in the local cluster; prod: the cluster's users. Dev can't read the prod value.
# @type=url
DB_USERS_ENDPOINT=if(forEnv(prod), vaultSecret("ghostmind/global/users/prod#DB_USERS_ENDPOINT"), vaultSecret("ghostmind/global/users#DB_USERS_ENDPOINT"))
# @sensitive
DB_USERS_SECRET=vaultSecret("ghostmind/global/users#DB_USERS_SECRET")
# Google sign-in (one OAuth client per product, shared with ui)
GOOGLE_OAUTH_CLIENT_ID=vaultSecret("ghostmind/project/block/auth")
# @sensitive
GOOGLE_OAUTH_CLIENT_SECRET=vaultSecret("ghostmind/project/block/auth")
# @sensitive
OAUTH_STATE_SECRET=vaultSecret("ghostmind/project/block/auth")
# Encrypts each person's own OpenRouter key at rest (ai/secret-box.ts): 32 bytes, base64. Read at call time.
# @sensitive
AI_KEY_ENCRYPTION_KEY=vaultSecret("ghostmind/project/block/auth")
# The picture of a shared block in its link card: a screenshot by Cloudflare Browser Rendering (blocks/cards.ts)
CLOUDFLARE_ACCOUNT_ID=vaultSecret("ghostmind/global/cloudflare")
CLOUDFLARE_BROWSER_TOKEN=vaultSecret("ghostmind/global/cloudflare")
